<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Changes 1.0.0</title>
    <organization>com.jazzytaudio</organization>
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64" rootVolumeOnly="true"/>
    <domains enable_localSystem="true" enable_currentUserHome="false" enable_anywhere="false"/>
    <os-version min="10.13"/>

    <choices-outline>
        <line choice="app"/>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="docs"/>
    </choices-outline>

    <choice id="app" title="Changes standalone app" description="The standalone application, installed in /Applications." start_selected="true">
        <pkg-ref id="com.jazzytaudio.changes.app"/>
    </choice>
    <choice id="au" title="Audio Unit plug-in (Logic, GarageBand, MainStage)" description="Installed in /Library/Audio/Plug-Ins/Components." start_selected="true">
        <pkg-ref id="com.jazzytaudio.changes.au"/>
    </choice>
    <choice id="vst3" title="VST3 plug-in (Ableton Live, Cubase, Reaper, Studio One, Bitwig, FL Studio)" description="Installed in /Library/Audio/Plug-Ins/VST3." start_selected="true">
        <pkg-ref id="com.jazzytaudio.changes.vst3"/>
    </choice>
    <choice id="docs" title="Manual and uninstaller" description="Installed in /Library/Application Support/JazzyT Audio/Changes." start_selected="true">
        <pkg-ref id="com.jazzytaudio.changes.docs"/>
    </choice>

    <pkg-ref id="com.jazzytaudio.changes.app" version="1.0.0" onConclusion="none">app.pkg</pkg-ref>
    <pkg-ref id="com.jazzytaudio.changes.au" version="1.0.0" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.jazzytaudio.changes.vst3" version="1.0.0" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.jazzytaudio.changes.docs" version="1.0.0" onConclusion="none">docs.pkg</pkg-ref>
</installer-gui-script>
